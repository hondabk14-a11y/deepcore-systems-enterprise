# Copy to .env locally. Never commit the real .env file.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPCORE_AI_MODEL=gpt-5.6-mini
# Optional OpenAI-compatible endpoint. For local vLLM:
# DEEPCORE_AI_BASE_URL=http://127.0.0.1:8000/v1
# For local SGLang:
# DEEPCORE_AI_BASE_URL=http://127.0.0.1:30000/v1
# DEEPCORE_AI_MODEL=deepseek-ai/DeepSeek-V4-Flash
# For OpenRouter:
# DEEPCORE_AI_BASE_URL=https://openrouter.ai/api/v1
# DEEPCORE_AI_MODEL=openai/gpt-4o
# Optional OpenRouter attribution headers:
# OPENROUTER_HTTP_REFERER=https://github.com/hondabk14-a11y/deepcore-systems-enterprise
# OPENROUTER_X_TITLE=DeepCore Systems Enterprise AI Bridge
